{
  "name": "raceiq-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:data": "node scripts/build-data.mjs",
    "predev": "npm run generate:data",
    "dev": "next dev",
    "prebuild": "npm run generate:data",
    "build": "next build",
    "start": "next start",
    "prelint": "npm run generate:data",
    "lint": "eslint .",
    "pretypecheck": "npm run generate:data",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:data",
    "test": "vitest run",
    "verify:worker": "node scripts/verify-worker-runtime.mjs",
    "precf:build": "npm run generate:data",
    "cf:build": "opennextjs-cloudflare build",
    "precf:preview": "npm run generate:data",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "precf:deploy": "npm run generate:data",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.123.0"
  }
}
